# TRL API — environment configuration
# Copy to .env and adjust. Every value has a safe default for local development.

# Port and interface the server binds to.
PORT=8080
HOST=0.0.0.0

# Where the JSON data file is written (leads, metrics).
DATA_DIR=./server/data

# Set a random token to protect the lead-listing endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGINS=https://therightlifestyle.github.io,http://localhost:8000,http://localhost:8080

# Maximum API requests per client IP per minute.
RATE_LIMIT=120

# Logging: info | debug | warn | error  ·  json | pretty
LOG_LEVEL=info
LOG_FORMAT=json
